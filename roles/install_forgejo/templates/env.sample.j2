# =============================================================================
# Forgejo stack — /srv/services/forgejo/.env
# Copy this file to .env and fill in real values.
#
#   cp .env.sample .env && vim .env
#
# Ansible manages .env.sample only. Your .env will never be touched.
# =============================================================================

# -----------------------------------------------------------------------------
# Forgejo process identity
# Run `id` as the user who owns /srv/services/forgejo to get these values.
# -----------------------------------------------------------------------------
FORGEJO_UID={{ vault_admin_uid | default('1000') }}
FORGEJO_GID={{ vault_admin_gid | default('1000') }}

# -----------------------------------------------------------------------------
# Domain
# -----------------------------------------------------------------------------
FORGEJO_DOMAIN={{ vault_forgejo_domain | default('git.example.com') }}

# -----------------------------------------------------------------------------
# SSH
# Port exposed on the host for Git SSH clones.
# Host port 22 is taken by server SSH — use something else (2222 is conventional).
# Clone URLs will be: ssh://git@{{ vault_forgejo_domain | default('git.example.com') }}:2222/user/repo.git
# -----------------------------------------------------------------------------
FORGEJO_SSH_PORT={{ vault_forgejo_ssh_port | default('2222') }}

# -----------------------------------------------------------------------------
# Security
# Generate both values with: openssl rand -hex 32
# -----------------------------------------------------------------------------
FORGEJO_SECRET_KEY={{ vault_forgejo_secret_key | default('replace_with_openssl_rand_hex_32') }}
FORGEJO_INTERNAL_TOKEN={{ vault_forgejo_internal_token | default('replace_with_openssl_rand_hex_32') }}

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB={{ vault_forgejo_db_name | default('forgejo') }}
POSTGRES_USER={{ vault_forgejo_db_user | default('forgejo') }}
POSTGRES_PASSWORD={{ vault_forgejo_db_password | default('replace_with_strong_password') }}

# -----------------------------------------------------------------------------
# Registrations
# true  = only you can create accounts (recommended for personal instance)
# false = open registration
# -----------------------------------------------------------------------------
FORGEJO_DISABLE_REGISTRATION={{ vault_forgejo_disable_registration | default('true') }}

# -----------------------------------------------------------------------------
# Mailer (set ENABLED=false to skip entirely)
# -----------------------------------------------------------------------------
FORGEJO_MAILER_ENABLED={{ vault_forgejo_mailer_enabled | default('false') }}
FORGEJO_SMTP_HOST={{ vault_forgejo_smtp_host | default('smtp.example.com') }}
FORGEJO_SMTP_PORT={{ vault_forgejo_smtp_port | default('587') }}
FORGEJO_SMTP_USER={{ vault_forgejo_smtp_user | default('you@example.com') }}
FORGEJO_SMTP_PASSWORD={{ vault_forgejo_smtp_password | default('replace_with_smtp_password') }}
FORGEJO_SMTP_FROM={{ vault_forgejo_smtp_from | default('forgejo@example.com') }}
